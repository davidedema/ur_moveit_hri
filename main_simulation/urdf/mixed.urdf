  base_link to UR 'Base' Coordinates transform -->
  <link name="robot1base" />
  <joint name="robot1base_link-base_fixed_joint" type="fixed"> <!-- Note the rotation over Z of pi
    radians - as base_link is REP-103 aligned (i.e., has X+ forward, Y+ left and Z+ up), this is
    needed to correctly align 'base' with the 'Base' coordinate system of the UR controller. -->
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0" />
    <parent link="robot1base_link" />
    <child link="robot1base" />
  </joint> <!-- ROS-Industrial 'flange' frame - attachment point for
  EEF models -->
  <link name="robot1flange" />
  <joint name="robot1wrist_3-flange" type="fixed">
    <parent link="robot1wrist_3_link" />
    <child link="robot1flange" />
    <origin rpy="0 -1.5707963267948966 -1.5707963267948966" xyz="0 0 0" />
  </joint> <!--
  ROS-Industrial 'tool0' frame - all-zeros tool frame -->
  <link name="robot1tool0" />
  <joint name="robot1flange-tool0" type="fixed"> <!-- default toolframe - X+ left, Y+ up, Z+ front -->
    <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0" />
    <parent link="robot1flange" />
    <child link="robot1tool0" />
  </joint>
